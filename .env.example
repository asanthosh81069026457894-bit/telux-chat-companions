# =============================================================================
# Telux — environment variables
#
# Two classes of variables:
#
#   VITE_*  — inlined into the BROWSER bundle at build time. Safe to ship
#             to every visitor. NEVER put a secret in one of these.
#
#   plain   — read from process.env on the SERVER. Used by serverFn
#             handlers, the webhook receiver, and the chat proxy.
#             These never reach the browser.
#
# On Vercel:
#   - Put VITE_* in Project Settings → Environment Variables (Production).
#   - Put the server-only ones there too. They're read at runtime from
#     process.env via the Nitro preset — no special "secret" tag needed.
#
# On a self-hosted Docker/Render/Fly deployment, set them via your platform's
# env-var store and never bake them into the image.
# =============================================================================


# ── Supabase — public (browser) ──────────────────────────────────────────────
# Find these in Supabase Dashboard → Project Settings → API.
# Both values are safe to ship to the browser; the anon key is gated by
# row-level security and auth.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY


# ── Supabase — server-only (NEVER prefix with VITE_) ─────────────────────────
# Required for every serverFn that writes to subscriptions /
# onboarding_responses. Without this, signup → onboarding → start trial →
# Razorpay webhook all fail silently.
# Dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY


# ── Groq — server-only ───────────────────────────────────────────────────────
# Powers every chat answer (the model is llama-3.1-8b-instant on Groq).
# Get a free key: https://console.groq.com → API Keys → Create API Key.
GROQ_API_KEY=YOUR_GROQ_KEY


# ── Razorpay — server-only ───────────────────────────────────────────────────
# Where to get them: https://dashboard.razorpay.com
#   - Toggle Test Mode (top-left of the dashboard) for development.
#   - Settings → API Keys → Generate Test Key  → gives RAZORPAY_KEY_ID and
#     RAZORPAY_KEY_SECRET (both prefixed with `rzp_test_` in test mode).
#   - Settings → Webhooks → Create New Webhook:
#       URL: https://YOUR_DEPLOY_DOMAIN/api/razorpay/webhook
#       Events: subscription.activated, subscription.charged,
#               subscription.completed, subscription.cancelled,
#               payment.captured
#       → gives RAZORPAY_WEBHOOK_SECRET (a separate string).
#   - Set all three via your deploy host's secret store. DO NOT prefix with
#     VITE_; the secret would be bundled into the browser.
#
# Webhook timing & retry policy:
#   - Razorpay retries a 4xx/5xx response up to 8 times over 24 hours.
#     Our handler returns 400 on bad signature / payload, so a misconfigured
#     secret will be retried — but the operator will see the warning in
#     deploy logs every time.
#   - 200 must be returned within 10 seconds, so we activatePaidPlan
#     synchronously before the response. If the Supabase write is slow the
#     webhook will retry; activatePaidPlan is idempotent so retries are safe.
#
# Test mode permissions (Test Mode):
#   - Only the test card numbers, UPI IDs and wallets in Razorpay's docs
#     work. See https://dashboard.razorpay.com/app/payments/test-cards.
#   - Webhooks fire normally to the URL you configured.
#   - No real money moves. You can use any test card like
#     4111 1111 1111 1111 / any future expiry / any CVV.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_test_key_id
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_webhook_secret

# Plan catalogue (descriptions stay in src/lib/usage.ts).
# Amounts are in PAISE (₹) so 19900 = ₹199.00. Used by the Razorpay serverFn
# when creating a subscription. Override these to change pricing without code.
RAZORPAY_PLAN_PERSONAL_MONTHLY=19900
RAZORPAY_PLAN_PERSONAL_YEARLY=189900
RAZORPAY_PLAN_PRO_MONTHLY=49900
RAZORPAY_PLAN_PRO_YEARLY=479900


# ── Optional ────────────────────────────────────────────────────────────────
# Override the origin used for auth redirect URLs. Leave unset in production;
# the client falls back to window.location.origin which is correct on Vercel.
# Set this only if you put the app behind a reverse proxy that rewrites the
# public host.
#
# VITE_AUTH_REDIRECT_ORIGIN=https://your-production-domain.com


# ── ElevenLabs (server-only, optional) ──────────────────────────────────────
# Powers higher-quality TTS for /talk and the chat read-aloud button. When
# unset the app silently falls back to the OS SpeechSynthesis voices — the
# feature still works, just with whatever voice your device ships.
#
# Where to get a key:
#   - Sign up at https://elevenlabs.io (free tier: ~10k chars/month).
#   - Profile → "API Key" → copy.
#   - Plan catalogue is at https://elevenlabs.io/app/voice-library — the
#     default voice is "Rachel" (id 21m00Tcm4TlvDq8ikWAM) which is a
#     female English voice. Override ELEVENLABS_DEFAULT_VOICE_ID to use a
#     different voice from your library; the /talk and chat panels both
#     route TTS through this single setting.
#
# Rate-limit safety:
#   - The synthesizeSpeech serverFn caps per-user usage at 60 calls/hour,
#     well below ElevenLabs' per-minute rate limit. When the cap is hit
#     the request falls back to browser TTS instead of erroring.
#   - The key is read only on the server. NEVER prefix with VITE_; that
#     would bundle it into the public JS bundle.
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_KEY
# ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM